{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true,
    "es2026": true
  },
  "ignorePatterns": [
    "build/**",
    "generated/**",
    "tests/.bin/**",
    "tests/.docker/**",
    "substreams/target/**",
    "substreams/tests/fixtures/**"
  ],
  "rules": {
    "complexity": ["error", 10]
  }
}
