{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "build/**",
    "generated/**",
    "tests/.bin/**",
    "tests/.latest.json",
    "abis/**",
    "subgraph.*.yaml",
    "substreams/target/**",
    "substreams/tests/fixtures/**"
  ]
}
